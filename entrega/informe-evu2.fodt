    <table:table-cell table:style-name="TablaCelda" office:value-type="string"><text:p text:style-name="TablaTexto">7.3</text:p></table:table-cell>
    <table:table-cell table:style-name="TablaCelda" office:value-type="string"><text:p text:style-name="TablaTexto">1, 16</text:p></table:table-cell>
  </table:table-row>
</table:table>

</office:text>
